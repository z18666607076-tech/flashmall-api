# Copy to .env.prod on the server. Never commit .env.prod.
# Generate APP_KEY with: php artisan key:generate --show
# (or, on a machine that already has PHP: docker run --rm php:8.4-cli php -r 'echo "base64:".base64_encode(random_bytes(32)), PHP_EOL;')

APP_NAME=FlashMall
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://shop.example.com
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Asia/Shanghai

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_DATABASE=flashmall
DB_USERNAME=flashmall
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-root

SESSION_DRIVER=redis
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis
CACHE_STORE=redis
REDIS_CLIENT=phpredis
REDIS_PASSWORD=null

# The public demo uses fake WeChat login and fake payments.
# DEMO_MODE=true forces those drivers even if the lines below say http.
WECHAT_DRIVER=fake
WECHAT_MINI_PROGRAM_APP_ID=
WECHAT_MINI_PROGRAM_SECRET=
PAYMENTS_DRIVER=fake

DEMO_MODE=true
DEMO_LOGIN_CODE=demo
DEMO_RESET_AT=03:00
DEMO_RESET_TIMEZONE=Asia/Shanghai

# Caddy is the only public entrypoint. Trust its forwarded visitor IP.
TRUST_PROXIES=true

# Safe defaults for a public demo on one 4 GB server.
API_RATE_LIMIT_PER_MINUTE=60
WECHAT_LOGIN_RATE_LIMIT_PER_MINUTE=10
CHECKOUT_RATE_LIMIT_PER_MINUTE=20
FLASH_PURCHASE_RATE_LIMIT_PER_MINUTE=30
HORIZON_MAX_PROCESSES=2

ORDER_UNPAID_TTL_SECONDS=900
CATALOG_CACHE_TTL=600

# Domain Caddy will obtain a certificate for. DNS must point at this server.
APP_DOMAIN=shop.example.com
SITE_ADDRESS=shop.example.com
CADDY_AUTO_HTTPS=on
ACME_EMAIL=you@example.com

# Host ports. Leave these at 80 and 443 on the server.
HTTP_PORT=80
HTTPS_PORT=443

# Optional build mirrors. Leave empty outside mainland China.
# APT_MIRROR=mirrors.aliyun.com
# COMPOSER_MIRROR=https://mirrors.aliyun.com/composer/
# PHP_IMAGE=php:8.4-fpm-bookworm
# COMPOSER_IMAGE=composer:2
# CADDY_IMAGE=caddy:2-alpine
# MYSQL_IMAGE=mysql:8.4
# REDIS_IMAGE=redis:7-alpine
