APP_NAME=FlashMall
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=flashmall
DB_USERNAME=flashmall
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# fake uses a deterministic local driver. Set http only when real mini program credentials exist.
WECHAT_DRIVER=fake
WECHAT_MINI_PROGRAM_APP_ID=
WECHAT_MINI_PROGRAM_SECRET=
WECHAT_API_BASE_URL=https://api.weixin.qq.com

CATALOG_CACHE_TTL=600

# Seconds before an unpaid order is cancelled and its stock is restored.
ORDER_UNPAID_TTL_SECONDS=900

# fake never calls WeChat Pay or Stripe. http signs live API requests.
# No merchant account or Stripe secret is configured in this repository.
PAYMENTS_DRIVER=fake

# Public demo. Production turns this on in .env.prod. See docs/DEPLOY.md.
DEMO_MODE=false
DEMO_LOGIN_CODE=demo
DEMO_RESET_AT=03:00
DEMO_RESET_TIMEZONE=Asia/Shanghai
TRUST_PROXIES=false
API_RATE_LIMIT_PER_MINUTE=60
WECHAT_LOGIN_RATE_LIMIT_PER_MINUTE=10
CHECKOUT_RATE_LIMIT_PER_MINUTE=30
FLASH_PURCHASE_RATE_LIMIT_PER_MINUTE=30
HORIZON_MAX_PROCESSES=2
PAYMENTS_WEBHOOK_TOLERANCE=300
WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_MCH_SERIAL=
WECHAT_PAY_PRIVATE_KEY=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_PLATFORM_PUBLIC_KEY=
WECHAT_PAY_PLATFORM_SERIAL=
WECHAT_PAY_NOTIFY_URL=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
